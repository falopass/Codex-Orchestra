# Local-only environment overrides. Copy to .env and keep that file untracked.
# Orchestra never needs provider API keys in this file.

# Isolate Orchestra state from the real local app-data directory.
CODEX_ORCHESTRA_DATA_DIR=

# Optional override for a managed Codex Router checkout.
CODEX_ORCHESTRA_ROUTER_ROOT=

# Optional override for the desktop executable used by deeplinks.
CODEX_ORCHESTRA_DESKTOP=

# Optional isolated Codex home for tests only. Do not point this at a real profile.
# CODEX_HOME=
